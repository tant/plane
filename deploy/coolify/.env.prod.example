# ====================================
# Plane Production Environment
# ====================================
# Copy this file to .env.prod and fill in the values

# App Release Version
APP_RELEASE=stable

# ====================================
# Security Keys (REQUIRED - Generate unique values!)
# ====================================
# Generate with: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-change-this
LIVE_SERVER_SECRET_KEY=your-live-server-secret-key-change-this

# ====================================
# Database Configuration
# ====================================
POSTGRES_USER=plane
POSTGRES_PASSWORD=your-strong-db-password
POSTGRES_DB=plane

# ====================================
# Redis Configuration
# ====================================
# Using default settings (no authentication)

# ====================================
# RabbitMQ Configuration
# ====================================
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=your-strong-rabbitmq-password
RABBITMQ_VHOST=plane

# ====================================
# Storage Configuration (MinIO/S3)
# ====================================
USE_MINIO=1
AWS_REGION=
AWS_ACCESS_KEY_ID=your-minio-access-key
AWS_SECRET_ACCESS_KEY=your-minio-secret-key
AWS_S3_BUCKET_NAME=uploads
FILE_SIZE_LIMIT=5242880

# ====================================
# URLs (Set by Coolify or manually)
# ====================================
# Your production domain (e.g., https://plane.yourdomain.com)
WEB_URL=https://plane.yourdomain.com
CORS_ALLOWED_ORIGINS=https://plane.yourdomain.com

# ====================================
# Server Configuration
# ====================================
LISTEN_HTTP_PORT=80
GUNICORN_WORKERS=4
API_KEY_RATE_LIMIT=60/minute
