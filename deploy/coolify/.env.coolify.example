# ===========================================
# Plane Coolify Environment Variables
# ===========================================
# Copy this to Coolify Environment Variables section
# Most values have sensible defaults, only SECRET_KEY and passwords are required

# Application URL (REQUIRED - set to your domain)
WEB_URL=https://plane.carp.vn

# Application Secrets (REQUIRED - generate secure values)
SECRET_KEY=your-secret-key-here
LIVE_SERVER_SECRET_KEY=your-live-secret-key-here

# Database (uses internal PostgreSQL by default)
POSTGRES_USER=plane
POSTGRES_PASSWORD=plane
POSTGRES_DB=plane

# Redis (uses internal Valkey by default)
# No configuration needed - handled internally

# RabbitMQ (uses internal RabbitMQ by default)
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=plane
RABBITMQ_VHOST=plane

# MinIO/S3 Storage (uses internal MinIO by default)
AWS_ACCESS_KEY_ID=access-key
AWS_SECRET_ACCESS_KEY=secret-key
AWS_S3_BUCKET_NAME=uploads

# Optional Settings
DEBUG=0
GUNICORN_WORKERS=2
FILE_SIZE_LIMIT=10485760
API_KEY_RATE_LIMIT=120/minute
CORS_ALLOWED_ORIGINS=
