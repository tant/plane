# ====================================
# Plane Development/Staging Environment
# ====================================
# Copy this file to .env.dev and fill in the values

# App Release Version (use 'preview' for latest dev builds)
APP_RELEASE=preview

# Custom Docker Registry (optional, for self-built images)
# DOCKER_REGISTRY=ghcr.io/your-org

# ====================================
# Security Keys (REQUIRED - Generate unique values!)
# ====================================
# Generate with: openssl rand -hex 32
SECRET_KEY=dev-secret-key-change-this
LIVE_SERVER_SECRET_KEY=dev-live-server-secret-key-change-this

# ====================================
# Database Configuration
# ====================================
POSTGRES_USER=plane_dev
POSTGRES_PASSWORD=plane_dev_password
POSTGRES_DB=plane_dev

# ====================================
# Redis Configuration
# ====================================
# Using default settings (no authentication)

# ====================================
# RabbitMQ Configuration
# ====================================
RABBITMQ_USER=plane_dev
RABBITMQ_PASSWORD=plane_dev_password
RABBITMQ_VHOST=plane_dev
# Expose management UI port (for debugging)
RABBITMQ_MANAGEMENT_PORT=15672

# ====================================
# Storage Configuration (MinIO/S3)
# ====================================
USE_MINIO=1
AWS_REGION=
AWS_ACCESS_KEY_ID=dev-access-key
AWS_SECRET_ACCESS_KEY=dev-secret-key
AWS_S3_BUCKET_NAME=uploads-dev
FILE_SIZE_LIMIT=10485760
# Expose MinIO console port (for debugging)
MINIO_CONSOLE_PORT=9090

# ====================================
# URLs (Set by Coolify or manually)
# ====================================
# Your dev/staging domain (e.g., https://dev.plane.yourdomain.com)
WEB_URL=https://dev.plane.yourdomain.com
CORS_ALLOWED_ORIGINS=https://dev.plane.yourdomain.com

# ====================================
# Server Configuration
# ====================================
LISTEN_HTTP_PORT=80
GUNICORN_WORKERS=2
API_KEY_RATE_LIMIT=120/minute
